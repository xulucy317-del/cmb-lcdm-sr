# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.venv/
# scheduler-free environment built by hpc/lightning/bootstrap_env.sh
.venv-lightning/
# local Julia install used by hpc/mac/
.julia-bin/

# Raw run outputs (SR runs, pooled tables, manifests). Consolidated
# deliverables are committed under experiments/; the raw fronts are not.
results/*
!results/README.md

# Caches under models/<run>/analysis/. The encoder-pass caches are the input
# every search and audit starts from, and the per-latent residual caches
# (residual_z*, f1hat_z*, residual_ols_z*) are the entry points of phases
# 5-8 and stages 2-3 that can only be rebuilt from the raw fronts. Both sets
# ARE meant to be committed (~15 MB; canonical sha256 in
# experiments/mse_one_stage_state_csd3.json and data/inputs_manifest.json;
# check with scripts/check_inputs.py). Everything else there is scratch.
models/*/analysis/*
!models/*/analysis/encoder_means_test.npy
!models/*/analysis/encoder_logvars_test.npy
!models/*/analysis/residual_z*_v1.npy
!models/*/analysis/f1hat_z*_v1.npy
!models/*/analysis/residual_ols_z*_v1.npy
!models/*/analysis/residual_ols_v1_fit.json

# Site configuration for hpc/submit.sh and hpc/run_tasks.sh (copy from
# hpc/site.env.example; contains your account/partition/paths)
hpc/site.env

# Logs / OS noise
logs/
.DS_Store

# Large external inputs are never vendored here (see README "Data and models").
# theta.npy + splits_v1.npz in data/ ARE tracked; the spectra shards are not.
data/shards_*

# Transfer bundles written by hpc/lightning/make_transfer_bundle.sh
*.tar.gz
*.tar.gz.sha256
*.manifest.txt

# Figure-script caches (regenerable: run the make_fig_ script that writes them)
figures/_cache_*.npz

# LaTeX build artifacts of the archived draft
docs/archive/paper_draft/*.aux
docs/archive/paper_draft/*.log
docs/archive/paper_draft/*.out
