# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
# no trailing slash: .venv here is a symlink (-> ../cmbvae/.venv)
.venv

# Generated outputs (SR runs, pooled tables, figures)
results/*
!results/.gitkeep

# Encoder-pass caches (regenerable from models/ + shards)
models/*/analysis/

# Logs / OS noise
logs/
.DS_Store

# Large external inputs are never vendored here (see README: data provenance).
# theta.npy + splits_v1.npz in data/ ARE tracked; spectra shards are not.
data/shards_*

# Figure-script caches (regenerable: run the make_fig_ script that writes them)
paper/figs/_cache_*.npz

# LaTeX build artifacts
paper/*.aux
paper/*.log
paper/*.out
