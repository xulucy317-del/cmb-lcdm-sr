# Site configuration for running the launchers somewhere other than CSD3.
#
#   cp hpc/site.env.example hpc/site.env      # hpc/site.env is git-ignored
#   $EDITOR hpc/site.env
#
# Read by hpc/submit.sh (any SLURM cluster) and hpc/run_tasks.sh (any other
# scheduler, or no scheduler). Plain KEY=VALUE lines, sourced by bash; every
# key is optional.

# Repository root on this machine. Default: the checkout the script lives in.
#PROJ=/path/to/cmb-lcdm-sr

# --- SLURM (hpc/submit.sh) -----------------------------------------------
# Passed as sbatch command-line options, which override the #SBATCH lines in
# the launchers (those record CSD3's account, partition and notification
# address). Leave a value empty to pass nothing for it.
SLURM_ACCOUNT=
SLURM_PARTITION=
# Anything else your site needs, e.g. "--qos=normal" or "--constraint=cpu".
# The launchers request 16 CPUs, 16 GB and 2-12 h per task; override with
# --time/--mem/--cpus-per-task here if your partition's limits differ.
SLURM_EXTRA=
# Failure notifications go here; empty means --mail-type=NONE.
MAIL_USER=

# --- inputs ----------------------------------------------------------------
# Directory holding shards_global_lhs/ and shards_global_lhs_ee_lowl/. Only the
# encoder pass, the spectral templates and the stage-4 attribution read it.
#SHARDS_ROOT=/path/to/shards

# --- hpc/run_tasks.sh ------------------------------------------------------
# Cores given to each task (the launchers run PySR with 16 Julia threads).
#TASK_CPUS=16
